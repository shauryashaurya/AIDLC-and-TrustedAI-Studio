{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "references.schema.json",
  "title": "AI-DLC × Trusted AI reference catalog",
  "description": "Single source of truth for references. data/references.md is generated from this file (npm run docs:gen).",
  "type": "object",
  "required": [
    "catalogVersion",
    "provenance",
    "types",
    "domains",
    "references"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "catalogVersion": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "provenance": {
      "type": "string",
      "minLength": 1
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "publisher",
          "domain",
          "type",
          "version",
          "publishedDate",
          "verifiedOn",
          "url",
          "pinnedUrl",
          "access",
          "license",
          "summary",
          "usedIn",
          "verificationNotes",
          "citedBy",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "publisher": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "type": "string",
            "description": "Must match a domains[].id"
          },
          "version": {
            "type": [
              "string",
              "null"
            ],
            "description": "Edition, release tag, revision or commit. Null when the official page shows none."
          },
          "publishedDate": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
          },
          "verifiedOn": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Date the official page last confirmed the details. Null only when status is 'unverified'."
          },
          "url": {
            "type": "string",
            "description": "https URL, or a data/ path for user-supplied inputs."
          },
          "pinnedUrl": {
            "type": [
              "string",
              "null"
            ],
            "description": "URL fixed to the cited version (tag, DOI, dated revision)."
          },
          "access": {
            "enum": [
              "free",
              "paid",
              "registration",
              "unknown"
            ]
          },
          "license": {
            "type": [
              "string",
              "null"
            ]
          },
          "citedBy": {
            "type": "object",
            "required": [
              "pages",
              "stages"
            ],
            "properties": {
              "pages": {
                "type": "array",
                "items": {
                  "enum": [
                    "home",
                    "workshop",
                    "discover",
                    "ideate",
                    "patterns",
                    "nfr",
                    "trust",
                    "lifecycle",
                    "reports",
                    "references"
                  ]
                }
              },
              "stages": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^\\d\\.\\d$"
                }
              }
            },
            "additionalProperties": false
          },
          "status": {
            "enum": [
              "current",
              "superseded",
              "unverified"
            ]
          },
          "type": {
            "type": "string",
            "description": "Plain document type; must be listed in types[]"
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "description": "What the source states about itself."
          },
          "usedIn": {
            "type": "string",
            "minLength": 1,
            "description": "Where this app uses the source."
          },
          "verificationNotes": {
            "type": "string",
            "description": "Facts observed during verification; empty when none."
          }
        },
        "additionalProperties": false
      }
    },
    "types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
