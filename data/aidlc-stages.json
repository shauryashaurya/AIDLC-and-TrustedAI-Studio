    "repo": "https://github.com/awslabs/aidlc-workflows",
    "tag": "v2.11.5",
    "verifiedOn": "2026-11-25",
    "referenceId": "aidlc-stages",
    "sources": {
      "stages": "https://github.com/awslabs/aidlc-workflows/blob/v2.11.5/docs/guide/04-phases-and-stages.md",
      "artifacts": "https://github.com/awslabs/aidlc-workflows/blob/v2.11.5/docs/guide/14-artifacts-reference.md",
      "agents": "https://github.com/awslabs/aidlc-workflows/blob/v2.11.5/docs/guide/06-agents.md",
      "profiles": "https://github.com/awslabs/aidlc-workflows/blob/v2.11.5/docs/guide/workflow-profiles.md",
      "scopes": "https://github.com/awslabs/aidlc-workflows/blob/v2.11.5/docs/guide/05-scopes-and-depth.md",
      "stageRules": "https://github.com/awslabs/aidlc-workflows/tree/v2.11.5/core/aidlc-common/stages"
    }
  },
  "note": "Copied from the AI-DLC v2.11.5 guide (chapters 04, 06, 14) and stage rule files (core/aidlc-common/stages, produces: lists). This app plans with this data; it does not run AI-DLC.",
  "rules": [
    "Every stage your scope runs, outside Initialization, ends with an approval gate. (04-phases-and-stages)",
    "A verification gate runs at each phase boundary except Initialization → Ideation. (04-phases-and-stages)",
    "Stages 3.1–3.5 run per Unit; 3.6 and 3.7 run once after all Units. (04-phases-and-stages)",
    "Execution modes: 29 inline, 2 subagent (2.2, 3.5), 1 pipeline (2.1), 1 mob (2.4). (04-phases-and-stages)",
    "Supporting agents take part only when the collaborators setting is on; otherwise the lead agent works alone. (04-phases-and-stages)",
    "Each stage writes its files under aidlc/spaces/<space>/intents/<YYMMDD>-<label>/. (14-artifacts-reference)",
    "A team template at aidlc/spaces/<space>/memory/templates/<artifact>.md is used whole-doc: its ## headings become the artifact skeleton and the required-sections sensor checks them. (core/aidlc-common/protocols/stage-protocol.md, Template overrides)"
  ],
  "phases": [
    {
      "id": 0,
      "name": "Initialization",
      "purpose": "Bootstrap the workspace: create the intent's record dir, detect the workspace, and initialize state."
    },
    {
      "id": 1,
      "name": "Ideation",
      "purpose": "Validate the initiative — capture intent, assess feasibility, define scope, form the team, and secure approval to proceed."
    },
    {
      "id": 2,
      "name": "Inception",
      "purpose": "Elaborate the requirements — analyze the codebase, elicit requirements, design architecture, decompose into units of work, and plan delivery."
    },
    {
      "id": 3,
      "name": "Construction",
      "purpose": "Build the solution — design, implement, and test — in reviewable slices."
    },
    {
      "id": 4,
      "name": "Operation",
      "purpose": "Deploy and operate — set up deployment pipelines, provision environments, configure observability, and establish feedback loops."
    }
  ],
