  "choose": [
    "/aidlc <profile> <description>, e.g. /aidlc bugfix Fix the login timeout issue",
    "/aidlc --scope <profile>",
    "/aidlc compose \"<request>\" asks the composer agent to propose a stage grid",
    "With no profile named, the assistant proposes one; the default is classic.",
    "Overrides: --depth minimal|standard|comprehensive, --test-strategy minimal|standard|comprehensive, --review adversarial|advisory|none"
  ],
  "depthLevels": [
    {
      "id": "minimal",
      "text": "Core essentials only. Short documents, key decisions, minimal supporting analysis."
    },
    {
      "id": "standard",
      "text": "Balanced detail. Complete requirements, architecture decisions with rationale, thorough test plans."
    },
    {
      "id": "comprehensive",
      "text": "Full enterprise detail. Exhaustive requirements, compliance matrices, detailed NFR specifications."
    }
  ],
  "testLevels": [
    {
      "id": "minimal",
      "text": "1 test per identified requirement plus a happy-path floor; about 5–15 tests for a typical project."
    },
    {
      "id": "standard",
      "text": "5–8 tests per component; unit and integration."
    },
    {
      "id": "comprehensive",
      "text": "10–15 tests per component; all test types."
    }
  ],
  "countNote": "Stage counts are as stated in the guide and exclude the 3 Initialization stages. The scopes page routing table uses a 33-stage basis instead (e.g. workshop 26/33).",
